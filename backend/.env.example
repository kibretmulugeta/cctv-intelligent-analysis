APP_NAME=CCTV Intelligent Analysis
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./cctv.db

# YOLO Model
YOLO_MODEL=yolo11n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
DEVICE=auto

# Frame Processing
FRAME_SKIP=1
FACE_FRAME_INTERVAL=5
OBJECT_DETECTION_INTERVAL=1

# Face Recognition
FACE_MATCH_THRESHOLD=0.50

# Upload Settings
MAX_UPLOAD_SIZE_MB=500
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv

# Directories
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
FACES_DIR=faces

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
